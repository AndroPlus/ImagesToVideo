<Window x:Class="ImagesToVideo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ImagesToVideo" Width="1280" Height="800" MinWidth="980" MinHeight="600"
        Icon="pack://application:,,,/assets/icon.ico" WindowStartupLocation="CenterScreen" AllowDrop="True">
    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="12,12,12,6" LastChildFill="False">
            <Button DockPanel.Dock="Left" Click="AddPhotos_Click" ToolTip="Add photos" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEB9F;" Style="{StaticResource IconText}" Margin="0,0,8,0" /><TextBlock Text="Add photos" /></StackPanel>
            </Button>
            <Button DockPanel.Dock="Left" Click="AddFolder_Click" ToolTip="Add every image in a folder" Margin="0,0,4,0">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F4;" Style="{StaticResource IconText}" Margin="0,0,8,0" /><TextBlock Text="Add folder" /></StackPanel>
            </Button>
            <Button x:Name="UpButton" DockPanel.Dock="Left" Click="MoveUp_Click" ToolTip="Move up" Margin="8,0,2,0">
                <TextBlock Text="&#xE74A;" Style="{StaticResource IconText}" />
            </Button>
            <Button x:Name="DownButton" DockPanel.Dock="Left" Click="MoveDown_Click" ToolTip="Move down" Margin="2,0">
                <TextBlock Text="&#xE74B;" Style="{StaticResource IconText}" />
            </Button>
            <Button x:Name="SortButton" DockPanel.Dock="Left" Click="Sort_Click" ToolTip="Sort by name" Margin="2,0">
                <TextBlock Text="&#xE8CB;" Style="{StaticResource IconText}" />
            </Button>
            <Button x:Name="RemoveButton" DockPanel.Dock="Left" Click="Remove_Click" ToolTip="Remove selected (Delete)" Margin="2,0">
                <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" />
            </Button>

            <Button x:Name="ExportButton" DockPanel.Dock="Right" Style="{StaticResource AccentButtonStyle}" Click="Export_Click" Padding="16,6">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE714;" Style="{StaticResource IconText}" Margin="0,0,8,0" /><TextBlock Text="Export video" /></StackPanel>
            </Button>
        </DockPanel>

        <!-- Photo list -->
        <Grid Grid.Row="1" Grid.Column="0" Margin="12,6,6,6">
            <ListBox x:Name="PhotoList" SelectionMode="Extended" SelectionChanged="PhotoList_SelectionChanged" KeyDown="PhotoList_KeyDown">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="{Binding Index}" Width="26" VerticalAlignment="Center" Opacity="0.6" />
                            <Border Width="64" Height="40" CornerRadius="4" ClipToBounds="True" Background="#22808080">
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border>
                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="150" ToolTip="{Binding Path}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Opacity="0.65"
                       IsHitTestVisible="False" Text="Drop photos or folders here&#x0a;or use Add photos" />
        </Grid>

        <!-- Preview -->
        <DockPanel Grid.Row="1" Grid.Column="1" Margin="6">
            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button x:Name="PlayButton" DockPanel.Dock="Left" Click="Play_Click" ToolTip="Play preview (Space)">
                    <TextBlock x:Name="PlayGlyph" Text="&#xE768;" Style="{StaticResource IconText}" />
                </Button>
                <TextBlock x:Name="TimeText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="10,0,0,0" Text="0:00 / 0:00" FontFamily="Consolas" />
                <Slider x:Name="Scrubber" IsMoveToPointEnabled="True" Margin="10,0,0,0" VerticalAlignment="Center" Minimum="0" Maximum="1" ValueChanged="Scrubber_ValueChanged" />
            </DockPanel>
            <TextBlock x:Name="PreviewInfo" DockPanel.Dock="Bottom" Margin="0,6,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            <Border Background="Black" CornerRadius="6" ClipToBounds="True">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock x:Name="PreviewHint" Foreground="#AAFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                               Text="Add photos to see a preview" />
                </Grid>
            </Border>
        </DockPanel>

        <!-- Settings -->
        <ScrollViewer Grid.Row="1" Grid.Column="2" Margin="6,6,12,6" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Video size" Style="{StaticResource Label}" Margin="0,0,0,4" />
                <ComboBox x:Name="SizeBox" SelectionChanged="Option_Changed" />
                <TextBlock Text="Frame rate" Style="{StaticResource Label}" />
                <ComboBox x:Name="FpsBox" SelectionChanged="Option_Changed" />

                <TextBlock x:Name="DurationLabel" Text="Seconds per photo" Style="{StaticResource Label}" />
                <Slider x:Name="DurationSlider" Minimum="1.5" Maximum="10" TickFrequency="0.5" IsSnapToTickEnabled="True" ValueChanged="Option_Changed" />

                <TextBlock Text="Transition" Style="{StaticResource Label}" />
                <ComboBox x:Name="TransitionBox" SelectionChanged="Option_Changed" />
                <TextBlock x:Name="TransitionDurationLabel" Text="Transition length" Style="{StaticResource Label}" />
                <Slider x:Name="TransitionSlider" Minimum="0.2" Maximum="3" TickFrequency="0.1" IsSnapToTickEnabled="True" ValueChanged="Option_Changed" />

                <TextBlock Text="Pan &amp; zoom" Style="{StaticResource Label}" />
                <ComboBox x:Name="MotionBox" SelectionChanged="Option_Changed" />
                <TextBlock x:Name="ZoomLabel" Text="Zoom amount" Style="{StaticResource Label}" />
                <Slider x:Name="ZoomSlider" Minimum="0" Maximum="0.5" TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="Option_Changed" />
                <TextBlock Text="Motion easing" Style="{StaticResource Label}" />
                <ComboBox x:Name="EasingBox" SelectionChanged="Option_Changed" />

                <TextBlock Text="Photo fit" Style="{StaticResource Label}" />
                <ComboBox x:Name="FitBox" SelectionChanged="Option_Changed" />

                <TextBlock Text="Music" Style="{StaticResource Label}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="ClearMusic_Click" ToolTip="Remove music" Margin="4,0,0,0">
                        <TextBlock Text="&#xE711;" Style="{StaticResource IconText}" />
                    </Button>
                    <Button DockPanel.Dock="Right" Click="ChooseMusic_Click" Content="Choose…" Margin="4,0,0,0" />
                    <TextBlock x:Name="MusicText" Text="None" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <TextBlock Text="FFmpeg" Style="{StaticResource Label}" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Click="LocateFFmpeg_Click" Content="Locate…" Margin="4,0,0,0" />
                    <TextBlock x:Name="FFmpegText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </DockPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Status / export progress -->
        <DockPanel Grid.Row="2" Grid.ColumnSpan="3" Margin="12,4,12,10">
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="Cancel" Visibility="Collapsed" Click="Cancel_Click" Margin="8,0,0,0" />
            <Button x:Name="OpenButton" DockPanel.Dock="Right" Content="Play video" Visibility="Collapsed" Click="Open_Click" Margin="8,0,0,0" />
            <Button x:Name="ShowButton" DockPanel.Dock="Right" Content="Show in folder" Visibility="Collapsed" Click="Show_Click" Margin="8,0,0,0" />
            <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="240" Height="6" Visibility="Collapsed" Margin="8,0,0,0" Maximum="1" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</Window>
